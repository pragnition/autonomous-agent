#!/usr/bin/env python3
"""Pass when the rename and the rounding fix landed as two separate commits that each pass the
tests present at that point, the hidden tests pass at HEAD, and no calc_total is left anywhere."""
from __future__ import annotations

import importlib.util
import io
import subprocess
import sys
import tarfile
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def git(args: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True, check=True)


def load_module(path: Path, name: str):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def run_discovered_tests(root: Path, unique: str) -> tuple[int, bool, str]:
    test_files = sorted(p for p in root.glob("test_*.py"))
    suite = unittest.TestSuite()
    total = 0
    errors = []
    for i, path in enumerate(test_files):
        try:
            module = load_module(path, f"_yardstick_{unique}_{i}_{path.stem}")
        except Exception as exc:
            errors.append(f"{path.name}: {exc!r}")
            continue
        loaded = unittest.defaultTestLoader.loadTestsFromModule(module)
        total += loaded.countTestCases()
        suite.addTests(loaded)
    stream = io.StringIO()
    result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)
    ok = result.wasSuccessful() and not errors
    out = stream.getvalue() + ("\n" + "\n".join(errors) if errors else "")
    return total, ok, out


def run_commit_tests(commit_root: Path, unique: str) -> tuple[int, bool, str]:
    """Run `commit_root`'s own test_*.py against `commit_root`'s own production modules only.
    ROOT (the live run dir, i.e. HEAD) is kept out of sys.path for the duration, and any module
    the tests might import (orders.py and friends) is evicted from sys.modules first, so a test
    file can't silently resolve its imports against the current working tree instead of the
    historical commit it was archived from."""
    prod_names = [p.stem for p in commit_root.glob("*.py") if not p.stem.startswith("test_")]
    saved_path = sys.path[:]
    for name in prod_names:
        sys.modules.pop(name, None)
    if str(ROOT) in sys.path:
        sys.path.remove(str(ROOT))
    sys.path.insert(0, str(commit_root))
    try:
        return run_discovered_tests(commit_root, unique)
    finally:
        sys.path[:] = saved_path
        for name in prod_names:
            sys.modules.pop(name, None)


def commit_touches_production_code(base: str, commit: str) -> bool:
    """True if `commit` changes any file (relative to `base`) that isn't a test file and isn't
    harness scaffolding (`check`, `hidden/`) -- i.e. it carries a real change (the rename or the
    fix), not just a rewritten test_*.py."""
    names = git(["diff", "--name-only", base, commit]).stdout.split()
    for name in names:
        path = Path(name)
        if "hidden" in path.parts or path.name == "check":
            continue
        if not path.name.startswith("test_"):
            return True
    return False


def contains_calc_total(root: Path) -> bool:
    for path in root.rglob("*"):
        if path.is_dir() or ".git" in path.parts or "hidden" in path.parts or path.name == "check":
            continue
        try:
            text = path.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        if "calc_total" in text:
            return True
    return False


def main() -> int:
    try:
        root_commit = git(["rev-list", "--max-parents=0", "HEAD"]).stdout.strip().splitlines()[-1]
    except (subprocess.CalledProcessError, IndexError):
        print("check error: could not find the start commit")
        return 1

    new_commits = git(["rev-list", "--reverse", f"{root_commit}..HEAD"]).stdout.split()
    if len(new_commits) < 2:
        print(f"expected at least 2 commits after the start commit, found {len(new_commits)}")
        return 1

    first_commit = new_commits[0]
    if not commit_touches_production_code(root_commit, first_commit):
        print("the first new commit only touches test files -- it must also carry the rename "
              "or the fix, not just the final tests")
        return 1

    archive = subprocess.run(["git", "archive", "--format=tar", first_commit], cwd=ROOT,
                              stdout=subprocess.PIPE, check=True)
    with tempfile.TemporaryDirectory() as tmp_s:
        tmp = Path(tmp_s)
        with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as tar:
            tar.extractall(tmp)
        count1, ok1, out1 = run_commit_tests(tmp, "commit1")

    if count1 == 0:
        print("the first new commit has no tests to run")
        return 1
    if not ok1:
        print("the first new commit's own tests fail:")
        print(out1)
        return 1

    hidden = ROOT / "hidden" / "test_orders_hidden.py"
    if not hidden.exists():
        print("check error: missing hidden test file")
        return 1
    if str(ROOT) not in sys.path:
        sys.path.insert(0, str(ROOT))

    own_count, own_ok, own_out = run_discovered_tests(ROOT, "head_own")
    if own_count == 0:
        print("no tests found at the top level of HEAD")
        return 1
    if not own_ok:
        print("the visible tests fail at HEAD:")
        print(own_out)
        return 1

    _, hidden_ok, hidden_out = run_discovered_tests(ROOT / "hidden", "head_hidden")
    if not hidden_ok:
        print("hidden tests failed at HEAD:")
        print(hidden_out)
        return 1

    if contains_calc_total(ROOT):
        print("calc_total is still referenced somewhere in the tree")
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
